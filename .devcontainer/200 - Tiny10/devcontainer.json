{
  "name": "Tiny11pro",
  "service": "windows",
  "containerEnv": {
    "VERSION": "https://archive.org/download/tiny11-26h2-by16yoshi/tiny11%2026h2%20beta%201.iso"
  },
  "forwardPorts": [8006],
  "portsAttributes": {
    "8006": {
      "label": "Web",
      "onAutoForward": "notify"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  }, 
  "dockerComposeFile": "../codespaces.yml",
  "initializeCommand": "docker system prune --all --force"
}
